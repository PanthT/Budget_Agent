# =====================================================================
#  Budget_Agent — Environment Variables
#  Copy this file to .env and fill in your real API keys.
#  NEVER commit .env to version control (it is gitignored).
# =====================================================================

# --- Model Providers ---

# OpenAI (https://platform.openai.com/api-keys)
OPENAI_API_KEY=sk-your-openai-key-here

# Anthropic / Claude (https://console.anthropic.com)
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key-here

# Cohere (https://dashboard.cohere.com/api-keys)
COHERE_API_KEY=your-cohere-key-here

# Google Gemini (https://aistudio.google.com/apikey)
GOOGLE_API_KEY=your-google-gemini-key-here
GOOGLE_CSE_ID=            # optional: Google Custom Search Engine ID

# OpenRouter (https://openrouter.ai/settings/keys)
# Unified access to hundreds of models (OpenAI, Anthropic, Llama, Mistral, DeepSeek, etc.)
# Used via ChatOpenAI pointed at https://openrouter.ai/api/v1
OPENROUTER_API_KEY=sk-or-your-openrouter-key-here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# --- Hugging Face ---
# (https://huggingface.co/settings/tokens)
HF_TOKEN=hf_your-huggingface-token-here

# --- Other / Optional ---

# Pinecone vector database (https://app.pinecone.io)
PINECONE_API_KEY=your-pinecone-key-here

# Weaviate vector database
WEAVIATE_URL=
WEAVIATE_API_KEY=

# LangSmith observability (https://smith.langchain.com)
LANGSMITH_API_KEY=
LANGSMITH_TRACING=true

# Tavily search API (https://tavily.com)
TAVILY_API_KEY=

# --- Local / Server config (optional) ---

# Ollama server (defaults to http://localhost:11434)
OLLAMA_BASE_URL=http://localhost:11434

# Default model selections
# LLM_MODEL_NAME=llama3.2:3b